# Browser bundle (GitHub Actions repository variables in production)
VITE_CATALOG_API_URL=http://localhost:10000
VITE_GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Vite development proxy
CATALOG_API_PROXY_TARGET=http://localhost:10000

# Render API (secrets/environment variables)
